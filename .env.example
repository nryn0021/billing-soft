# Copy to .env and adjust. Never commit the real .env.

# --- PostgreSQL connection (used by the app and drizzle-kit) ---
# Local host (running `npm run dev` against a local/compose Postgres):
DATABASE_URL=postgres://jmd:jmd_password@localhost:5432/jmd_mill
# Set to "true" for managed Postgres that requires TLS (RDS, Neon, Supabase, ...).
PGSSL=false
# Optional pool sizing.
PG_POOL_MAX=10

# --- Values consumed by docker-compose to provision the db container ---
POSTGRES_USER=jmd
POSTGRES_PASSWORD=jmd_password
POSTGRES_DB=jmd_mill

# --- Application ---
PORT=8787
# NODE_ENV is set by docker-compose for the container. Do NOT put NODE_ENV=production
# in this .env file — Vite reads .env during `npm run build` and rejects it.
# Set to "true" only when served over HTTPS so session cookies get the Secure flag.
JMD_HTTPS=false

# --- Encryption secret for bank account numbers (AES-256-GCM) ---
# MUST be a strong, stable secret. If it changes or is lost, previously encrypted
# bank details become unrecoverable. Back it up securely.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JMD_DATA_SECRET=change-me-to-a-long-random-secret

# --- Default seed tenant (optional overrides) ---
JMD_TENANT_SLUG=jmd
JMD_TENANT_NAME=Jai Mata Di Gud Mill
